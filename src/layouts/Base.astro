---
import Localized from '../components/Localized.astro';
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/noto-sans-jp/400.css';
import T from '../components/T.astro';
import { profile } from '../lib/data';
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  article?: boolean;
}
const { title, description = profile.bio, article = false } = Astro.props;
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — Vision & Language`;
const nav = [
  ['/', 'nav_home'],
  ['/papers/', 'nav_papers'],
  ['/cv/', 'nav_cv'],
  ['/sandbox/', 'nav_sandbox'],
  ['/labels/', 'nav_labels'],
  ['/blog/', 'nav_notes'],
];
const path = Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {path === '/404.html' && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#2563eb" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Koki Maeda — Research Notes"
      href="/feed.xml"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:image" content={new URL(profile.image, Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark')
          document.documentElement.dataset.theme = 'dark';
        const lang = localStorage.getItem('lang') === 'ja' ? 'ja' : 'en';
        document.documentElement.dataset.lang = lang;
        document.documentElement.lang = lang;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main"><Localized en="Skip to content" ja="本文へ移動" /></a>
    <header class="site-header container">
      <a
        class="wordmark"
        href="/"
        aria-label="Koki Maeda, home"
        data-en="Koki Maeda, home"
        data-ja="前田 航希、ホーム"
        data-translate-attribute="aria-label"
        ><span class="brand-mark" aria-hidden="true"></span>silviase<span class="wordmark-dot"
          >.</span
        ></a
      >
      <nav
        aria-label="Main navigation"
        data-en="Main navigation"
        data-ja="メインナビゲーション"
        data-translate-attribute="aria-label"
      >
        {
          nav.map(([href, key]) => (
            <a
              href={href}
              aria-current={
                (href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined
              }
            >
              <T id={key} />
            </a>
          ))
        }
      </nav>
      <div class="header-tools">
        <div class="language-switch" role="group" aria-label="Language / 言語">
          <button type="button" data-language="en" aria-pressed="true" lang="en">EN</button>
          <button type="button" data-language="ja" aria-pressed="false" lang="ja">日本語</button>
        </div>
        <button class="theme-toggle" type="button" aria-label="Switch to dark mode"
          ><svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
            ><path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5a8.5 8.5 0 1 0 10.6 10.6Z"></path></svg
          ></button
        >
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <a href="/">Koki Maeda <span class="muted">/ silviase</span></a><span
        >Vision &amp; Language</span
      ><a href="https://github.com/Silviase/Silviase.github.io"
        ><Localized en="Source ↗" ja="ソースコード ↗" /></a
      >
    </footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
