---
import Localized from '../../components/Localized.astro';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { dateLabel } from '../../lib/data';
const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Research Notes"
  ><div class="container">
    <header class="page-heading">
      <p class="eyebrow">
        <Localized en="IDEAS / PROCESS / TOOLS" ja="アイデア / 研究過程 / ツール" />
      </p><h1>
        <Localized en="Research notes" ja="研究ノート" /><span class="blue">.</span>
      </h1><p>
        <Localized
          en="Practical tips and lessons from multimodal and NLP research."
          ja="マルチモーダル・自然言語処理の研究で得た知見や、実践に役立つヒントをまとめています。"
        />
      </p>
    </header><div class="notes-list">
      {
        posts.map((post) => (
          <article class="timeline-row">
            <>
              <p class="mono muted">{dateLabel(post.data.date)}</p>
              <div>
                <>
                  <h2 lang="ja">
                    <a href={`/blog/${post.id}/`}>{post.data.title} ↗</a>
                  </h2>
                  <p class="muted" lang="ja">
                    {post.data.excerpt}
                  </p>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </div></Base
>
