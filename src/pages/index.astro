---
import Localized from '../components/Localized.astro';
import Base from '../layouts/Base.astro';
import Paper from '../components/Paper.astro';
import Background from '../components/Background.astro';
import T from '../components/T.astro';
import { profile, themes } from '../lib/data';
import { getCollection } from 'astro:content';
const papers = (await getCollection('papers')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base>
  <div class="container">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">
          <Localized en="RESEARCHER / VISION & LANGUAGE" ja="研究者 / 視覚と言語" />
        </p><h1>
          Koki Maeda<span class="japanese-name" lang="ja">前田 航希</span>
        </h1><p class="hero-tagline">
          <Localized en={profile.tagline} ja={profile.tagline_ja} />
        </p><p class="hero-bio"><Localized en={profile.bio} ja={profile.bio_ja} /></p><div
          class="hero-links"
        >
          {
            profile.contacts
              .filter((link) => !['Blog', 'CV'].includes(link.label))
              .map((link) => (
                <a href={link.url}>
                  {link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              ))
          }
        </div><a class="text-link hero-cta" href="/papers/"
          ><Localized en="Explore my research" ja="研究業績を見る" />
          <span aria-hidden="true">↓</span></a
        >
      </div>
      <figure class="hero-portrait">
        <div class="portrait-frame">
          <img src={profile.image} alt="Koki Maeda" width="380" height="440" fetchpriority="high" />
        </div><figcaption>
          <span class="mono">TOKYO, JAPAN</span><span aria-hidden="true">35.68° N / 139.76° E</span>
        </figcaption>
      </figure>
    </section>
    <section class="section research">
      <div class="section-heading">
        <span class="section-index"><Localized en="01 / RESEARCH" ja="01 / 研究" /></span><h2>
          <Localized
            en="Understanding across vision and language"
            ja="視覚と言語をつなぐ理解へ"
          /><span class="blue">.</span>
        </h2>
      </div><div class="research-grid">
        {
          themes.map((theme, i) => (
            <article>
              <>
                <span class="mono research-number">0{i + 1}</span>
                <h3>
                  <Localized en={theme.title} ja={theme.title_ja} />
                </h3>
                <p>
                  <Localized en={theme.description} ja={theme.description_ja} />
                </p>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section class="section">
      <div class="section-heading heading-row">
        <div>
          <span class="section-index"><Localized en="02 / PUBLICATIONS" ja="02 / 研究業績" /></span
          ><h2><T id="papers_recent" /></h2>
        </div><a class="text-link" href="/papers/"
          ><T id="btn_browse_papers" /> <span aria-hidden="true">↗</span></a
        >
      </div><div class="paper-list">
        {papers.slice(0, 5).map((paper) => <Paper paper={paper} compact />)}
      </div>
    </section>
    <Background />
  </div>
</Base>
