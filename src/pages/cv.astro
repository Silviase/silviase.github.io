---
import Localized from '../components/Localized.astro';
import T from '../components/T.astro';
import Base from '../layouts/Base.astro';
import Background from '../components/Background.astro';
import { profile, cvPublications } from '../lib/data';
import { getCollection } from 'astro:content';
const papers = (await getCollection('papers')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const groups = [
  { title: 'papers_journals', papers: papers.filter((p) => p.data.type === 'journal') },
  {
    title: 'papers_conferences',
    papers: papers.filter(
      (p) => p.data.type === 'international' && p.data.venue !== 'arXiv preprint'
    ),
  },
  { title: 'papers_preprints', papers: papers.filter((p) => p.data.venue === 'arXiv preprint') },
  { title: 'papers_domestic', papers: papers.filter((p) => p.data.type === 'domestic') },
];
let start = 1;
---

<Base title="Curriculum Vitae"
  ><div class="container cv-page">
    <header class="page-heading">
      <p class="eyebrow"><Localized en="CURRICULUM VITAE" ja="経歴・研究業績" /></p><div
        class="heading-row"
      >
        <h1><Localized en={profile.name} ja="前田 航希" /><span class="blue">.</span></h1><button
          class="button print-button"
          type="button"
          data-print><Localized en="Print / Save PDF ↗" ja="印刷 / PDF を保存 ↗" /></button
        >
      </div><p><Localized en={profile.tagline} ja={profile.tagline_ja} /></p><div
        class="hero-links"
      >
        {
          profile.contacts
            .filter((link) => !['Blog', 'CV'].includes(link.label))
            .map((link) => <a href={link.url}>{link.label} ↗</a>)
        }
      </div>
    </header><section class="cv-summary">
      <h2><Localized en="Research focus" ja="研究内容" /></h2><p>
        <Localized en={profile.bio} ja={profile.bio_ja} />
      </p><ul>
        <li>
          <Localized
            en="Designing instruction-tuned multimodal LLMs and evaluation pipelines that balance academic
          rigor with deployability."
            ja="学術的な厳密さと実環境での利用を両立する、指示チューニング済みマルチモーダル大規模言語モデルと評価手法の設計。"
          />
        </li><li>
          <Localized
            en="Building curated Japanese-language datasets for captioning, reasoning, and cultural
          understanding in vision-language systems."
            ja="画像説明生成・推論・文化理解に向けた、日本語の高品質な視覚言語データセットの構築。"
          />
        </li>
      </ul>
    </section><Background /><section class="section cv-publications">
      <div class="section-heading">
        <span class="section-index"><Localized en="PUBLICATIONS" ja="研究業績" /></span><h2>
          <Localized en="Full publication list" ja="全研究業績" />
        </h2>
      </div>{
        groups.map((group) => {
          const first = start;
          start += group.papers.length;
          return (
            <section>
              <>
                <h3>
                  <T id={group.title} />
                </h3>
                <ol start={first}>
                  {group.papers.map((paper) => {
                    const entry = cvPublications.find((e) => e.id === paper.id);
                    return (
                      <li>
                        <p>{paper.data.authors.join(', ')}</p>
                        <a href={`/papers/${paper.id}/`}>
                          <strong>{paper.data.title}</strong>
                        </a>
                        <p class="muted">
                          {[
                            paper.data.venue || paper.data.journal,
                            entry?.date,
                            entry?.location,
                            entry?.pages,
                            entry?.page_count,
                            entry?.column,
                          ]
                            .filter(Boolean)
                            .join(' · ')}
                        </p>
                      </li>
                    );
                  })}
                </ol>
              </>
            </section>
          );
        })
      }
    </section>
  </div></Base
>
<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
