---
import Localized from '../../components/Localized.astro';
import Base from '../../layouts/Base.astro';
---

<Base title="Sandbox" lang="ja"
  ><div class="container">
    <header class="page-heading">
      <p class="eyebrow">EXPERIMENTS / INTERACTIVE</p><h1>Sandbox<span class="blue">.</span></h1><p>
        <Localized
          en="Explore research ideas through interactive experiments."
          ja="研究のアイデアを、触れて理解する。"
        />
      </p>
    </header><a class="demo-card" href="/sandbox/projection-lab/"
      ><div class="demo-preview" aria-hidden="true">
        <div class="demo-axis"></div>{
          Array.from({ length: 32 }, (_, i) => (
            <span
              style={`left:${16 + ((i * 17) % 68)}%;top:${20 + ((i * 23) % 55)}%;opacity:${0.35 + (i % 4) * 0.2}`}
            />
          ))
        }<span class="demo-caption mono">3D → 1D</span>
      </div><div class="demo-copy">
        <p class="eyebrow">DIMENSIONALITY REDUCTION</p><h2>Projection Lab ↗</h2><p>
          <Localized
            en="Choose a view of a 3D point cloud and compare your intuitive axis with the first principal component from PCA."
            ja="3D 点群を眺める向きを選び、自分の直感的な軸と PCA の第1主成分を比較するインタラクティブデモ。"
          />
        </p><span class="text-link"><Localized en="Open experiment →" ja="デモを開く →" /></span>
      </div></a
    >
  </div></Base
>
