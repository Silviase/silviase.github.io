---
import Localized from '../../components/Localized.astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { dateLabel } from '../../lib/data';
export async function getStaticPaths() {
  return (await getCollection('papers')).map((paper) => ({
    params: { id: paper.id },
    props: { paper },
  }));
}
const { paper } = Astro.props;
const p = paper.data;
const { Content } = await render(paper);
---

<Base title={p.title} description={p.description} article
  ><article class="container article-page">
    <a class="back-link" href="/papers/"><Localized en="← All publications" ja="← 論文一覧へ" /></a
    ><header class="page-heading">
      <p class="eyebrow">{p.type} / {dateLabel(p.date)}</p><h1 class="article-title">
        {p.title}
      </h1><p class="authors">{p.authors.join(', ')}</p><p class="blue">{p.venue || p.journal}</p>{
        p.description && <p>{p.description}</p>
      }<div class="hero-links">
        {
          (p.pdf || p.pdf_link) && (
            <a class="button" href={p.pdf || p.pdf_link}>
              <Localized en="Read PDF ↗" ja="PDF を読む ↗" />
            </a>
          )
        }{p.doi && <a href={`https://doi.org/${p.doi}`}>DOI ↗</a>}{
          p.code_link && (
            <a href={p.code_link}>
              <Localized en="Code ↗" ja="コード ↗" />
            </a>
          )
        }
      </div>
    </header><div class="prose"><Content /></div>{
      p.bibtex && (
        <section class="bibtex-block">
          <>
            <div class="heading-row">
              <>
                <h2>
                  <Localized en="Citation" ja="引用情報" />
                </h2>
                <button class="copy-bibtex" type="button" data-bibtex={p.bibtex} aria-live="polite">
                  <Localized en="Copy BibTeX" ja="BibTeX をコピー" />
                </button>
              </>
            </div>
            <pre>
              <code>{p.bibtex.trim()}</code>
            </pre>
          </>
        </section>
      )
    }
  </article></Base
>
