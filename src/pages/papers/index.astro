---
import Localized from '../../components/Localized.astro';
import Base from '../../layouts/Base.astro';
import Paper from '../../components/Paper.astro';
import T from '../../components/T.astro';
import { getCollection } from 'astro:content';
const papers = (await getCollection('papers')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const years = [...new Set(papers.map((p) => p.data.date.getUTCFullYear()))];
const groups = [
  ['journal', 'papers_journals'],
  ['international', 'papers_international'],
  ['domestic', 'papers_domestic'],
];
---

<Base title="Papers"
  ><div class="container">
    <header class="page-heading">
      <p class="eyebrow"><Localized en="RESEARCH / PUBLICATIONS" ja="研究 / 論文一覧" /></p><h1>
        <T id="papers_title" /><span class="blue">.</span>
      </h1><p>
        <Localized
          en="Publications, preprints, and the work behind them."
          ja="論文・プレプリントと、各研究の詳細を紹介します。"
        />
      </p>
    </header>
    <div class="paper-filters" data-filters hidden>
      <label class="search-label"
        ><Localized en="Search" ja="検索" /><input
          type="search"
          placeholder="Title, author, or venue"
          data-en="Title, author, or venue"
          data-ja="タイトル・著者・発表先"
          data-translate-attribute="placeholder"
          data-search-input
        /></label
      ><label
        ><T id="papers_filter_type" /><select data-type-filter
          ><option value="" data-en="All types" data-ja="すべての種別">All types</option><option
            value="journal"
            data-en="Journal"
            data-ja="学術誌">Journal</option
          ><option value="international" data-en="International" data-ja="国際会議・プレプリント"
            >International</option
          ><option value="domestic" data-en="Domestic" data-ja="国内会議">Domestic</option></select
        ></label
      ><label
        ><T id="papers_filter_year" /><select data-year-filter
          ><option value="" data-en="All years" data-ja="すべての年">All years</option>{
            years.map((year) => <option value={year}>{year}</option>)
          }</select
        ></label
      >
    </div>
    <p class="result-count mono muted" data-result-count aria-live="polite">
      {papers.length} publications
    </p>
    {
      groups.map(([type, label]) => (
        <section class="publication-group" data-paper-group>
          <h2>
            <T id={label} />
          </h2>
          {papers
            .filter((p) => p.data.type === type)
            .map((paper) => (
              <Paper paper={paper} />
            ))}
        </section>
      ))
    }
    <p data-empty hidden>
      <Localized
        en="No publications match these filters. Try another search."
        ja="条件に一致する論文はありません。検索語や絞り込み条件を変更してください。"
      />
    </p>
  </div></Base
>
<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]')!;
  filters.hidden = false;
  const search = document.querySelector<HTMLInputElement>('[data-search-input]')!;
  const type = document.querySelector<HTMLSelectElement>('[data-type-filter]')!;
  const year = document.querySelector<HTMLSelectElement>('[data-year-filter]')!;
  const rows = [...document.querySelectorAll<HTMLElement>('[data-paper]')];
  function update() {
    let count = 0;
    for (const row of rows) {
      row.hidden = !(
        row.dataset.search!.includes(search.value.trim().toLowerCase()) &&
        (!type.value || row.dataset.type === type.value) &&
        (!year.value || row.dataset.year === year.value)
      );
      if (!row.hidden) count++;
    }
    document.querySelectorAll<HTMLElement>('[data-paper-group]').forEach((group) => {
      group.hidden = !group.querySelector('[data-paper]:not([hidden])');
    });
    document.querySelector('[data-result-count]')!.textContent =
      document.documentElement.dataset.lang === 'ja'
        ? `${count} 件の論文`
        : `${count} publication${count === 1 ? '' : 's'}`;
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = count > 0;
  }
  filters.addEventListener('input', update);
  document.addEventListener('languagechange', update);
  update();
</script>
